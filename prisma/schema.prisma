generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  nickname      String?
  schoolId      String?
  groupId       String?
  points        Int       @default(0)
  role          String    @default("user") // user | admin
  onboarded     Boolean   @default(false)
  termsAgreed   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school        School?   @relation(fields: [schoolId], references: [id])
  group         Group?    @relation(fields: [groupId], references: [id])

  liveNotes     LiveNote[]
  summaries     Summary[]
  questions     Question[]
  answers       Answer[]
  reports       Report[]   @relation("ReporterReports")
  coursesCreated Course[]  @relation("CourseCreator")
  courseMembers  CourseMember[]
  blockedBy     Block[]    @relation("BlockedUser")
  blockedUsers  Block[]    @relation("BlockingUser")
  eventLogs     EventLog[]
}

model School {
  id          String   @id @default(cuid())
  name        String
  countryCode String
  createdAt   DateTime @default(now())

  users       User[]
  groupsA     Group[]  @relation("SchoolA")
  groupsB     Group[]  @relation("SchoolB")
}

model Group {
  id          String   @id @default(cuid())
  name        String
  schoolAId   String
  schoolBId   String
  inviteCode  String   @unique
  createdAt   DateTime @default(now())

  schoolA     School   @relation("SchoolA", fields: [schoolAId], references: [id])
  schoolB     School   @relation("SchoolB", fields: [schoolBId], references: [id])

  users       User[]
  courses     Course[]
}

model Course {
  id           String   @id @default(cuid())
  groupId      String
  title        String
  description  String   @default("")
  tags         String   @default("") // JSON array as string
  timezone     String   @default("Asia/Seoul")
  scheduleJson String   @default("") // JSON: [{dayOfWeek, startTime, endTime}]
  inviteCode   String   @unique
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  group        Group    @relation(fields: [groupId], references: [id])
  creator      User     @relation("CourseCreator", fields: [createdBy], references: [id])

  sessions     Session[]
  questions    Question[]
  members      CourseMember[]
}

model CourseMember {
  id        String   @id @default(cuid())
  courseId   String
  userId     String
  joinedAt   DateTime @default(now())

  course    Course   @relation(fields: [courseId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([courseId, userId])
}

model Session {
  id         String   @id @default(cuid())
  courseId    String
  startsAt   DateTime
  endsAt     DateTime
  weekLabel  String?
  createdAt  DateTime @default(now())

  course     Course    @relation(fields: [courseId], references: [id])
  liveNotes  LiveNote[]
  summaries  Summary[]
  questions  Question[]
}

model LiveNote {
  id         String   @id @default(cuid())
  sessionId  String
  authorId   String
  content    String
  tags       String   @default("") // JSON array
  status     String   @default("active") // active | hidden
  createdAt  DateTime @default(now())

  session    Session  @relation(fields: [sessionId], references: [id])
  author     User     @relation(fields: [authorId], references: [id])
}

model Summary {
  id          String   @id @default(cuid())
  sessionId   String
  authorId    String
  content     String
  tags        String   @default("") // JSON array
  generatedBy String   @default("manual") // ai | manual
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session     Session  @relation(fields: [sessionId], references: [id])
  author      User     @relation(fields: [authorId], references: [id])
}

model Question {
  id              String   @id @default(cuid())
  courseId         String
  sessionId        String
  authorId         String
  title           String
  body            String
  tags            String   @default("") // JSON array
  status          String   @default("open") // open | solved
  acceptedAnswerId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course          Course   @relation(fields: [courseId], references: [id])
  session         Session  @relation(fields: [sessionId], references: [id])
  author          User     @relation(fields: [authorId], references: [id])
  answers         Answer[]
}

model Answer {
  id          String   @id @default(cuid())
  questionId  String
  authorId    String
  body        String
  isAccepted  Boolean  @default(false)
  createdAt   DateTime @default(now())

  question    Question @relation(fields: [questionId], references: [id])
  author      User     @relation(fields: [authorId], references: [id])
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  targetType  String   // note | summary | question | answer | user
  targetId    String
  reason      String
  status      String   @default("open") // open | closed
  createdAt   DateTime @default(now())

  reporter    User     @relation("ReporterReports", fields: [reporterId], references: [id])
}

model Block {
  id            String   @id @default(cuid())
  blockingUserId String
  blockedUserId  String
  createdAt     DateTime @default(now())

  blockingUser  User     @relation("BlockingUser", fields: [blockingUserId], references: [id])
  blockedUser   User     @relation("BlockedUser", fields: [blockedUserId], references: [id])

  @@unique([blockingUserId, blockedUserId])
}

model EventLog {
  id        String   @id @default(cuid())
  userId    String
  event     String
  metadata  String   @default("") // JSON
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}
